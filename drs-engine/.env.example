# Copy to .env and edit. All settings are optional.

# AI second opinion: none | ollama | anthropic
DRS_LLM_PROVIDER=none

# Local, private option (recommended for internal data): install Ollama, then `ollama pull llama3.1:8b`
# DRS_LLM_PROVIDER=ollama
# DRS_LLM_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

# External API option - only if policy allows descriptions to leave the firm
# DRS_LLM_PROVIDER=anthropic
# DRS_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# PORT=8050
# DRS_DB=data/drs.db
